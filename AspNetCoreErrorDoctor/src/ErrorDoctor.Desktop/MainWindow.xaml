<Window x:Class="ErrorDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طبيب أخطاء ASP.NET Core"
        Height="760" Width="1080"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="طبيب أخطاء ASP.NET Core"
                       FontSize="26" FontWeight="Bold" Foreground="#FF1B2A4A" />
            <TextBlock Text="الصق رسالة الخطأ أو الـ Stack Trace، وسيقترح التطبيق السبب والحل من قاعدة بيانات تعمل بدون إنترنت."
                       FontSize="14" Foreground="#FF55617A" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Input + actions -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Text="{Binding ErrorText, UpdateSourceTrigger=PropertyChanged}"
                         Height="150"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Courier New"
                         FontSize="13"
                         FlowDirection="LeftToRight"
                         Padding="8"
                         BorderBrush="{StaticResource BorderBrush}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="تشخيص الخطأ" Command="{Binding DiagnoseCommand}" MinWidth="140" />
                    <Button Content="تحديث قاعدة البيانات" Command="{Binding CheckUpdatesCommand}"
                            Background="#FF455571" Margin="10,0,0,0" MinWidth="160" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="8" Margin="14,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <TextBlock Text="لا توجد نتائج مطابقة. جرّب لصق نص الخطأ كاملاً، أو اضغط (تحديث قاعدة البيانات)."
                           Foreground="#FF8A93A6" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8" Padding="14" CornerRadius="10"
                                        Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="{StaticResource AccentBrush}"
                                                    CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConfidenceText}" Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Header}" FontSize="17" FontWeight="Bold"
                                                       Foreground="#FF1B2A4A" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#FFEFF3FB" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#FF455571" />
                                            </Border>
                                            <Border Background="#FFFBEFEF" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Severity}" FontSize="12" Foreground="#FFB23A3A" />
                                            </Border>
                                            <Border Background="#FFEFF7EF" CornerRadius="6" Padding="8,2">
                                                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="#FF3A7A45" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="السبب المحتمل:" FontWeight="Bold" Margin="0,12,0,2" Foreground="#FF1B2A4A" />
                                        <TextBlock Text="{Binding Cause}" TextWrapping="Wrap" Foreground="#FF333A47" />

                                        <TextBlock Text="الحل:" FontWeight="Bold" Margin="0,12,0,2" Foreground="#FF1B2A4A" />
                                        <TextBox Text="{Binding Solution, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" BorderThickness="0" Background="#FFF8FAFD"
                                                 Padding="8" FontSize="13" FlowDirection="LeftToRight" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding HasSourceUrl, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="المصدر: " VerticalAlignment="Center" Foreground="#FF55617A" />
                                            <TextBlock>
                                                <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnRequestNavigate">
                                                    <TextBlock Text="{Binding SourceUrl}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Text="{Binding MatchedTerms}" FontSize="11" Foreground="#FF9AA3B5"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource PanelBrush}"
                CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding DatabaseInfo}" Foreground="#FF55617A" FontSize="12" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF1B2A4A" FontSize="12"
                           HorizontalAlignment="Right" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

@page
@model FormFlow.Web.Pages.Admin.SubmissionsModel
@{
    ViewData["Title"] = "ردود الاستمارة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">ردود: @Model.Template.Title</h4>
    <a class="btn btn-outline-success" asp-page="/Admin/Submissions" asp-page-handler="Export" asp-route-templateId="@Model.Template.Id">تصدير CSV</a>
</div>

@if (Model.Submissions.Count == 0)
{
    <div class="alert alert-info">لا توجد ردود بعد.</div>
}
else
{
    <table class="table table-hover bg-white">
        <thead>
            <tr>
                <th>رمز المتابعة</th>
                <th>مقدم الاستمارة</th>
                <th>الحالة</th>
                <th>المرحلة الحالية</th>
                <th>تاريخ الإنشاء</th>
                <th>آخر تحديث</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Model.Submissions)
            {
                var stage = Model.Template.Stages.FirstOrDefault(s => s.Order == submission.CurrentStageOrder);
                <tr>
                    <td>@submission.TrackingCode</td>
                    <td>@submission.SubmitterName</td>
                    <td><span class="badge @DisplayNames.StatusBadgeClass(submission.Status) text-white">@DisplayNames.Status(submission.Status)</span></td>
                    <td>@(submission.Status == SubmissionStatus.Completed ? "-" : stage?.Title)</td>
                    <td>@submission.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@submission.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Submission" asp-route-id="@submission.Id">التفاصيل</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-link" asp-page="/Admin/Index">رجوع</a>
